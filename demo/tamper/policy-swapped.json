{
  "spec": "mint.policy/0.1",
  "version": 1,
  "note": "Reads pass. Anything that commits is held until an approval bound to that exact action is presented, and released once. A step that matches no rule is refused even if an approval is offered, because an approval authorises a described action and nothing here can be described. (This copy was altered after the log was signed: a held write is refused instead.)",
  "on_write_without_approval": "refuse",
  "on_unclassifiable": "refuse",
  "approvals_are_single_use": true,
  "reads": [
    {
      "when": [
        {
          "attr": "has_href",
          "value": "yes"
        }
      ],
      "class": "read"
    },
    {
      "when": [
        {
          "attr": "action",
          "value": "type"
        }
      ],
      "class": "read"
    },
    {
      "when": [
        {
          "attr": "tag",
          "value": "a"
        }
      ],
      "class": "read"
    },
    {
      "when": [
        {
          "attr": "role",
          "value": "link"
        }
      ],
      "class": "read"
    }
  ],
  "writes": [
    {
      "when": [
        {
          "attr": "tag",
          "value": "button"
        }
      ],
      "class": "write"
    },
    {
      "when": [
        {
          "attr": "role",
          "value": "button"
        }
      ],
      "class": "write"
    },
    {
      "when": [
        {
          "attr": "tag",
          "value": "input"
        }
      ],
      "class": "write"
    }
  ]
}