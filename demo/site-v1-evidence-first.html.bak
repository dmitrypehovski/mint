<!doctype html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>mint — an agent runtime that does not pay twice for the same decision</title>
<style>
  :root{
    --bg:#080a0f; --panel:#0f1219; --panel2:#131722; --line:#1f2432;
    --ink:#e9edf6; --dim:#8b94a9; --dim2:#5d6579;
    --acc:#7c5ce7; --good:#4ade80; --warn:#f0b95c; --bad:#ff6b6b;
    --mono:ui-monospace,SFMono-Regular,"SF Mono",Menlo,monospace;
    --sans:ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
  }
  *{box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{margin:0;background:var(--bg);color:var(--ink);font:16.5px/1.6 var(--sans);
       -webkit-font-smoothing:antialiased}
  a{color:var(--acc);text-decoration:none}
  a:hover{text-decoration:underline}
  .wrap{max-width:1080px;margin:0 auto;padding:0 26px}
  header{position:sticky;top:0;z-index:20;background:rgba(8,10,15,.86);backdrop-filter:blur(10px);
         border-bottom:1px solid var(--line)}
  nav{display:flex;gap:22px;align-items:center;padding:14px 0;font-size:14.5px;flex-wrap:wrap}
  nav b{font-weight:700;letter-spacing:-.02em;font-size:16px}
  nav a{color:var(--dim)} nav a:hover{color:var(--ink);text-decoration:none}
  .hero{padding:74px 0 44px}
  h1{font-size:clamp(30px,5vw,52px);line-height:1.06;letter-spacing:-.035em;margin:0 0 20px;font-weight:760}
  .hero p.lede{font-size:19px;color:var(--dim);max-width:820px;margin:0 0 26px}
  .hero p.lede b{color:var(--ink);font-weight:600}
  .cta{display:flex;gap:12px;flex-wrap:wrap;align-items:center}
  .btn{display:inline-block;padding:11px 18px;border-radius:10px;border:1px solid var(--line);
       background:var(--panel);color:var(--ink);font-size:15px;font-weight:600}
  .btn.primary{background:var(--acc);border-color:var(--acc);color:#fff}
  .btn:hover{text-decoration:none;transform:translateY(-1px)}
  section{padding:52px 0;border-top:1px solid var(--line)}
  h2{font-size:clamp(22px,3vw,30px);letter-spacing:-.025em;margin:0 0 8px;font-weight:720}
  .sub{color:var(--dim);margin:0 0 26px;max-width:840px}
  h3{font-size:17px;margin:26px 0 8px;letter-spacing:-.01em}
  .grid{display:grid;gap:16px}
  .g2{grid-template-columns:repeat(auto-fit,minmax(320px,1fr))}
  .g3{grid-template-columns:repeat(auto-fit,minmax(250px,1fr))}
  .card{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:20px}
  .card h4{margin:0 0 8px;font-size:16.5px;letter-spacing:-.01em}
  .card p{margin:0;color:var(--dim);font-size:15px}
  .card .tag{display:inline-block;font:11.5px/1 var(--mono);letter-spacing:.08em;text-transform:uppercase;
             color:var(--acc);margin-bottom:10px}
  .num{font:700 34px/1 var(--mono);letter-spacing:-.03em;font-variant-numeric:tabular-nums}
  .num.good{color:var(--good)} .num.bad{color:var(--bad)} .num.warn{color:var(--warn)}
  .num small{font:500 13px/1 var(--sans);color:var(--dim);margin-left:6px}
  table{width:100%;border-collapse:collapse;font-size:14.5px;margin-top:6px}
  th,td{text-align:left;padding:10px 12px;border-bottom:1px solid var(--line);vertical-align:top}
  th{color:var(--dim2);font:600 12px/1.3 var(--mono);letter-spacing:.06em;text-transform:uppercase}
  td.n{font-family:var(--mono);font-variant-numeric:tabular-nums;white-space:nowrap}
  tr.hl td{background:rgba(74,222,128,.05)}
  code,pre{font-family:var(--mono);font-size:13.5px}
  pre{background:#05070b;border:1px solid var(--line);border-radius:12px;padding:16px;overflow:auto}
  .ok{color:var(--good)} .no{color:var(--bad)} .mid{color:var(--warn)}
  ul{margin:8px 0 0;padding-left:20px;color:var(--dim)} li{margin:7px 0}
  ul.tight li{margin:4px 0}
  .kicker{color:var(--acc);font:600 12.5px/1 var(--mono);letter-spacing:.1em;text-transform:uppercase;
          display:block;margin-bottom:10px}
  footer{padding:40px 0 70px;color:var(--dim2);font-size:14px;border-top:1px solid var(--line)}
  .pill{display:inline-block;padding:4px 9px;border:1px solid var(--line);border-radius:999px;
        font:12px/1.4 var(--mono);color:var(--dim);margin:0 6px 6px 0}
  .big{font:700 15px/1.5 var(--mono)}
  .split{display:grid;grid-template-columns:1fr 1fr;gap:16px}
  @media(max-width:760px){.split{grid-template-columns:1fr}}
</style></head>
<body>

<header><div class="wrap"><nav>
  <b>mint</b>
  <a href="#split">What is new</a>
  <a href="#how">How it works</a>
  <a href="#surfaces">Surfaces</a>
  <a href="#numbers">Measurements</a>
  <a href="#unlocks">What speed unlocks</a>
  <a href="#all">All applications</a>
  <a href="#limits">Limits</a>
  <a href="/live" style="color:var(--acc);margin-left:auto">Live run →</a>
</nav></div></header>

<div class="wrap hero">
  <h1>An agent runtime that does not pay twice for the same decision.</h1>
  <p class="lede">
    It is not a browser agent. The first run solves a procedure the ordinary way — a model picks
    every step — and the runtime writes down not the actions but the <b>shape</b> of them. That
    compiles into a small program: every later run executes it <b>on changed data</b>, calls
    <b>no model at all</b>, and <b>checks whether each step did what it promised</b>.
  </p>
  <p class="lede">
    The <b>compiler does not know what a browser is</b>. It recognises a target by shape, acts on
    it, and verifies the result it was meant to produce. Swap the eyes and the hands — a desktop,
    a phone, a terminal, a pile of files, an API — and the same compiled program still checks
    itself. The browser was first only because it is the hardest surface of them all.
  </p>
  <div class="cta">
    <a class="btn primary" href="/live">Open the live run</a>
    <a class="btn" href="/measurements.json">Raw measurements</a>
    <a class="btn" href="#numbers">Read the numbers</a>
  </div>
  <p style="margin-top:22px;color:var(--dim2);font-size:14.5px">
    Measured on this machine, today. Nine tasks chained, three skills, three repositories,
    learned on one of them.
  </p>
</div>

<section id="split"><div class="wrap">
  <span class="kicker">The honest split</span>
  <h2>Most of this was built before. Here is exactly which part is new.</h2>
  <p class="sub">Claiming novelty where there is none is the fastest way to lose an engineer's
  attention. So: four things that already existed, and three properties that did not.</p>
  <div class="split">
    <div class="card">
      <h4 class="no">Already existed</h4>
      <ul class="tight">
        <li><b>Learn-a-macro-from-a-demonstration</b> — that is RPA, twenty years old. Its failure
          mode has a name: it breaks when the data changes.</li>
        <li><b>Recorded selectors</b> — Selenium and Playwright codegen. Break even faster: the
          selector is tied to the markup.</li>
        <li><b>A model in the loop at every step</b> — browser-use, computer-use, Operator. Works on
          new data, pays a model for every step, every time, forever.</li>
        <li><b>Semantic caching</b> — a cache of text, not of actions; does not help here.</li>
      </ul>
    </div>
    <div class="card">
      <h4 class="ok">What is new</h4>
      <ul class="tight">
        <li><b>The selector is a shape</b> — not a path, not a label. So a skill learned on one
          instance transfers to its siblings: another repository, another tenant, another form of
          the same kind.</li>
        <li><b>Every step knows the page it must produce, and the runtime checks it.</b> From that:
          a mis-click is told apart from a reversal, a wrong step is repaired and the correction is
          written back into the skill, and every step reports which tier answered it.</li>
        <li><b>The model's answer is absorbed into the skill, not discarded.</b> Consequence,
          opposite to every other agent product: <b>the more often a task repeats, the cheaper it
          gets</b> — down to zero. Everyone else's cost is linear in the number of runs.</li>
      </ul>
    </div>
  </div>
</div></section>

<section id="how"><div class="wrap">
  <span class="kicker">How it works</span>
  <h2>Three layers, and in each one a decision that had to be made this way.</h2>
  <div class="grid g3" style="margin-top:8px">
    <div class="card">
      <span class="tag">Observe</span>
      <h4>Read the DOM, not the accessibility tree</h4>
      <p>The tree does not carry <code>href</code>, and without it a step cannot be recognised on a
      page whose contents changed — which is the whole point. Every element is stamped with a
      handle, and actions go through the handle: <b>no coordinates are computed at all</b>, so
      there is nothing to mis-aim and nothing to recalculate when the layout shifts.</p>
    </div>
    <div class="card">
      <span class="tag">Compile</span>
      <h4>The trajectory becomes a program</h4>
      <p>Role, the shape of where the element points, its place among elements of that shape, and
      the page it must produce. The skill is plain readable JSON, <b>which means it can be read and
      signed off before it ever runs</b>. That is a governance property, not a convenience.</p>
    </div>
    <div class="card">
      <span class="tag">Execute</span>
      <h4>Recognise, act, verify, heal</h4>
      <p>The tier that answered is named aloud for every step: shape, words, or model. A miss is a
      question, not a failure — the one step is re-asked and the answer is written back. A run that
      cannot say where each decision came from cannot be audited, and auditability is the product.</p>
    </div>
  </div>
  <div class="card" style="margin-top:16px">
    <h4>What it is not</h4>
    <p>Not a macro (it survives changed data). Not a cache (it resolves against live state instead
    of replaying yesterday's answer). Not a wrapper around a model (the model leaves the loop).</p>
  </div>
</div></section>

<section id="surfaces"><div class="wrap">
  <span class="kicker">One runtime, many pairs of eyes and hands</span>
  <h2>The compiler does not know what a browser is.</h2>
  <p class="sub">It learns three things and nothing else: recognise the target by its shape, act on
  it, check the result it was supposed to produce. Everything beyond that is an adapter — a
  definition of what counts as state and what counts as an action. The browser came first because it
  is the <b>hardest</b> surface: the page redraws under you, the contents change, nothing is
  versioned. Every other surface below is easier.</p>
  <table><thead><tr><th>Surface</th><th>What counts as state</th><th>What an action is</th>
    <th>Status</th></tr></thead><tbody>
    <tr class="hl"><td>Web browser</td><td>DOM: roles, addresses, labels</td>
      <td>click, type, navigate</td><td class="ok">built — measured on this page</td></tr>
    <tr><td>Desktop GUI</td><td>accessibility tree, window titles</td>
      <td>click, focus, type, menu</td><td>same compiler, new adapter</td></tr>
    <tr><td>Android phone</td><td>view hierarchy, intents</td>
      <td>tap, swipe, type, launch</td><td>same compiler, new adapter</td></tr>
    <tr><td>Terminal / CLI</td><td>prompt shape, output text</td>
      <td>run a command, answer a prompt</td><td>same compiler, new adapter</td></tr>
    <tr><td>Files &amp; folders</td><td>names, contents, structure</td>
      <td>create, move, edit, rename</td><td>same compiler, new adapter</td></tr>
    <tr><td>HTTP APIs</td><td>payload shapes</td>
      <td>call, page, retry</td><td>same compiler, new adapter</td></tr>
    <tr><td>Email (IMAP)</td><td>headers, threads, bodies</td>
      <td>file, reply, label</td><td>same compiler, new adapter</td></tr>
    <tr><td>Database</td><td>tables, columns, schemas</td>
      <td>query, insert, update</td><td>same compiler, new adapter</td></tr>
  </tbody></table>
  <p class="sub" style="margin-top:18px">Keeping the model out of the loop is what makes the other
  surfaces reachable at all. On a phone, in a terminal, on a factory panel, a 600 ms round trip per
  step is not <i>slow</i> — it is unusable. At 30 µs it is a function call.</p>
</div></section>

<section id="numbers"><div class="wrap">
  <span class="kicker">Measurements</span>
  <h2>Every number here was produced by a run, not estimated.</h2>
  <p class="sub">Collected <span id="when">—</span> on the machine that serves this page. Raw JSON at
  <a href="/measurements.json">/measurements.json</a>.</p>

  <h3>Observation is not the bottleneck — the model is</h3>
  <div id="obs-table"></div>

  <h3>The decision: 20,000× apart, and zero model calls</h3>
  <div class="grid g3" style="margin-top:14px">
    <div class="card"><div class="kicker">Model decides, per step</div>
      <div class="num bad" id="m-model">—</div><p>median over six runs, real page state</p></div>
    <div class="card"><div class="kicker">Compiled skill decides, per step</div>
      <div class="num good" id="m-skill">—</div><p>resolution against live state, no network</p></div>
    <div class="card"><div class="kicker">Model calls on the second run</div>
      <div class="num good">0</div><p>and on the third, and on the thousandth</p></div>
  </div>

  <h3>The chain: nine tasks, three skills, three repositories, learned on one</h3>
  <div id="chain-table"></div>

  <h3>The skills themselves</h3>
  <div id="skill-table"></div>
  <p class="sub" style="margin-top:14px">A skill is under a kilobyte. It fits in a code review.</p>
</div></section>

<section id="unlocks"><div class="wrap">
  <span class="kicker">What the speed actually unlocks</span>
  <h2>Speed does not make the same things faster. It changes what you can attempt.</h2>
  <p class="sub">These are consequences of a decision costing 30 microseconds instead of 600
  milliseconds. Each one is something that is simply not attempted today, because at the old price
  it makes no sense.</p>
  <div class="grid g2">
    <div class="card"><span class="tag">1 · verify instead of sample</span>
      <h4>You check everything, because checking is free</h4>
      <p>Audit practice samples because each check costs money. At 30 µs you verify all five hundred
      pages after a migration instead of fifty, all tenants instead of the loudest one, every lead
      time instead of a spot check. <b>Sampling exists because verification is expensive; remove
      the expense and the whole idea of a sample disappears.</b></p></div>

    <div class="card"><span class="tag">2 · search your own strategies</span>
      <h4>The runtime can try a hundred paths and keep the best</h4>
      <p>If trying costs nothing, compiling one skill is a waste. Compile several variants of the
      same task, benchmark them against live pages, keep the fastest and most stable. This is
      <b>the runtime searching its own skill space</b> — and it is only possible because the inner
      loop has no model in it. Measured: the compiled skill already does the work in 9 steps where
      the model took 18, without anyone searching anything.</p></div>

    <div class="card"><span class="tag">3 · agents inside a request</span>
      <h4>An agent you can call in the request path</h4>
      <p>Today nobody puts an agent inside a web request: 600 ms per step makes it impossible. At
      30 µs the compiled path can sit in the request path of ordinary software — checking a form,
      resolving a record, validating a submission — the way any other function does.</p></div>

    <div class="card"><span class="tag">4 · continuous, not periodic</span>
      <h4>Drift detection every five minutes instead of every quarter</h4>
      <p>Interface drift monitoring is a subscription nobody buys, because a periodic crawl costs
      money per run. With zero marginal cost a canary runs continuously, and it reports not
      "the page changed" but <b>"a working process broke, here"</b> — because a skill that fails to
      resolve its step is exactly that signal.</p></div>

    <div class="card"><span class="tag">5 · cost per shape, not per run</span>
      <h4>Pricing flips from per-execution to per-shape</h4>
      <p>If the thousandth run is free, the cost of a task is paid once and then amortised over
      everything. In a market where agents are paid per task, <b>the agent that has done the work
      before can undercut everyone without giving up margin</b>. That is an economic property, not
      an engineering one, and it is the one that changes who wins.</p></div>

    <div class="card"><span class="tag">6 · no network in the decision</span>
      <h4>An agent that works with the network off</h4>
      <p>The compiled path makes no model call, so no rate limit, no credit limit, no key
      revocation, no provider outage can touch it. This is not degraded mode — it is the full
      function. It is the only way an agent runs in a defence, medical, industrial or field
      setting, and it is the configuration nobody builds because everyone assumed a model on
      every step.</p></div>
  </div>
</div></section>

<section id="all"><div class="wrap">
  <span class="kicker">All applications</span>
  <h2>Every kind of application, in one click.</h2>
  <p class="sub">Grouped by <b>why it is possible</b>, not by industry — because the reason it works
  is the same across all of them, and the industry is only the door you walk in through. Each entry
  names the property it leans on, so a real application can be told from a wish.</p>

  <div style="display:flex;gap:12px;flex-wrap:wrap;align-items:center;margin:24px 0 10px">
    <button class="btn primary" id="expand" style="cursor:pointer;font-size:15.5px">Show all applications</button>
    <span style="color:var(--dim2);font-size:14px" id="hint"></span>
  </div>
  <div id="chips" style="margin-bottom:20px"></div>
  <div id="apps"></div>

  <h3>What has to be true for each of them</h3>
  <ul>
    <li><b>The class really is one class.</b> Transfer works when the targets share a shape. Proving
      it needs three real forms of one kind — the next experiment.</li>
    <li><b>Learning stays cheap.</b> Today it costs a handful of model calls. A harder class costs
      more, but still once.</li>
    <li><b>The interface does not churn monthly.</b> If it does, the win is eaten — which is exactly
      what the drift canary is for.</li>
  </ul>
</div></section>

<section id="limits"><div class="wrap">
  <span class="kicker">Limits</span>
  <h2>Where this does not help. Stated by us, before anyone asks.</h2>
  <div class="grid g2">
    <div class="card"><h4>One-off tasks</h4><p>There is nothing to learn; the second run never comes.</p></div>
    <div class="card"><h4>Judgement every time</h4><p>Reading an unfamiliar document and deciding what
      to do is a judgement, not a shape. Nothing to compile.</p></div>
    <div class="card"><h4>Canvas interfaces</h4><p>If elements differ neither by address nor by label,
      the selector has nothing to hold on to.</p></div>
    <div class="card"><h4>Interface churn</h4><p>Frequent redesigns send every run back to the model —
      and you pay again, though with self-repair rather than breakage.</p></div>
    <div class="card"><h4>One site family so far</h4><p>Proven inside one family of pages. A different
      site means new learning: cheap, but not free.</p></div>
    <div class="card"><h4>Whole-task speedup is smaller than per-decision</h4><p>The chain runs 3×
      faster, not 20,000×: page loads dominate, and nobody can speed those up. We improved the
      thinking, not the network, and we say so.</p></div>
  </div>
</div></section>

<footer><div class="wrap">
  <div class="big" style="margin-bottom:12px">mint</div>
  <div style="margin-bottom:14px">
    <span class="pill">Rust</span><span class="pill">Chrome DevTools Protocol, no wrapper</span>
    <span class="pill">tokio</span><span class="pill">Gemini 2.5 Flash via OpenRouter</span>
    <span class="pill">Python relay</span><span class="pill">Cloudflare Tunnel</span>
  </div>
  <p style="max-width:820px">Built for Night Hack at Founders, Inc. The runtime core, the observation
  layer and the first skill compiler existed before the kickoff; the two-pane showcase, the live
  streaming, the structural verdict, the no-op/reversal split, the second and third skills, the
  nine-task chain, the measurements on this page and the public deployment were built during the
  sprint.</p>
  <p><a href="/live">Live run</a> · <a href="/measurements.json">measurements.json</a></p>
</div></footer>

<script>
// На одно решение, из прогона цепочки: 18 задач у обычного агента, 9 у mint.
// Цели задавались по-русски, потому что так обучались навыки; на сайте — английские
// формулировки того же самого, чтобы страница читалась целиком.
const goalEN = {
  'gh-commit': 'open the latest commit of this repository',
  'gh-issues': 'open the issue list of this repository',
  'gh-prs':    'open the pull request list of this repository'
};
const chain = {
  slow: {steps: 18, calls: 18, per_dec_us: 640774, total_s: 24.9},
  fast: {steps: 9,  calls: 0,  per_dec_us: 32,     total_s: 7.7}
};
function nf(x){ return Number(x).toLocaleString('en-US'); }
function showRatio(a,b){ return Math.round(a/b).toLocaleString('en-US'); }

(async () => {
  let m = null;
  try { m = await (await fetch('measurements.json', {cache:'no-store'})).json(); } catch(e) {}
  if (!m) return;
  document.getElementById('when').textContent = m.collected_at || '—';

  const obs = document.getElementById('obs-table');
  let rows = `<table><thead><tr><th>Page</th><th>Actionable elements</th>
    <th>Capture, median</th><th>Our state payload</th>
    <th>Accessibility tree</th><th>Smaller by</th></tr></thead><tbody>`;
  for (const p of m.pages) {
    rows += `<tr><td>${p.url.replace('https://github.com/dmitrypehovski/','')}</td>
      <td class="n">${p.elements}</td>
      <td class="n">${p.capture_ms_median} ms <span style="color:var(--dim2)">(${p.capture_ms_min}–${p.capture_ms_max})</span></td>
      <td class="n">${nf(p.state_bytes)} B</td>
      <td class="n">${nf(p.naive_tree_bytes)} B <span style="color:var(--dim2)">· ${nf(p.naive_tree_nodes)} nodes</span></td>
      <td class="n ok">${p.reduction_vs_tree}×</td></tr>`;
  }
  obs.innerHTML = rows + '</tbody></table>';

  const model = m.model||{};
  document.getElementById('m-model').innerHTML = `${model.ms_median||'—'}<small>ms</small>`;
  const compiled = chain.fast.per_dec_us/1000;
  document.getElementById('m-skill').innerHTML = `${compiled.toFixed(3)}<small>ms</small>`;

  const perSlow = chain.slow.per_dec_us;
  const perFast = chain.fast.per_dec_us;
  document.getElementById('chain-table').innerHTML = `<table><thead><tr>
    <th></th><th>Ordinary agent</th><th>mint</th><th>Ratio</th></tr></thead><tbody>
    <tr><td>Decisions for the same work</td><td class="n">${chain.slow.steps}</td>
      <td class="n ok">${chain.fast.steps}</td><td class="n">the compiled skill found the short path</td></tr>
    <tr><td>Model calls</td><td class="n">${chain.slow.calls}</td>
      <td class="n ok">${chain.fast.calls}</td><td class="n ok">all of them removed</td></tr>
    <tr><td>Time per decision</td><td class="n">${nf(Math.round(perSlow))} µs</td>
      <td class="n ok">${(perFast).toFixed(0)} µs</td>
      <td class="n ok">${showRatio(perSlow, perFast)}×</td></tr>
    <tr class="hl"><td>Whole chain</td><td class="n">${chain.slow.total_s} s</td>
      <td class="n ok">${chain.fast.total_s} s</td>
      <td class="n ok">${(chain.slow.total_s/chain.fast.total_s).toFixed(1)}×</td></tr>
    </tbody></table>
    <p style="color:var(--dim);font-size:14.5px;margin-top:10px">The gap between 20,000× and 3× is
    the honest part: page loads dominate the chain and no one can speed those up. We improved the
    thinking, not the network.<br>
    Across repeated runs: the compiled decision measured <b>0.030–0.034 ms</b> and the model
    <b>605–667 ms</b>; the chain 23.7–25.9 s against 6.9–8.4 s. The table above is one run, not the
    best one.</p>`;

  let srows = `<table><thead><tr><th>Skill</th><th>Goal</th><th>Steps</th>
    <th>File size</th><th>Learned with</th><th>Verified</th></tr></thead><tbody>`;
  for (const [k,v] of Object.entries(m.skills||{})) {
    srows += `<tr><td class="n">${k}</td><td>${goalEN[k] || v.goal}</td><td class="n">${v.steps}</td>
      <td class="n">${v.bytes} B</td><td class="n">${v.learn_model_calls} calls · ${v.learn_ms} ms</td>
      <td class="n ${v.verified?'ok':'no'}">${v.verified?'yes':'no'}</td></tr>`;
  }
  document.getElementById('skill-table').innerHTML = srows + '</tbody></table>';
})();
</script>
<script>
/* Every kind of application, in one click.
   f — family, t — title, l — what it actually is, p — the property it leans on,
   s — 'proven' means measured on this machine during the sprint, 'next' means the same
   machinery with a new adapter. Nothing here is claimed as built that is not built. */
const APPS = [
 {f:'Registries & compliance', t:'Company status across hundreds of registries',
  l:'Every municipal or state registry is the same shape of form with different data. Learn one, transfer to 299.', p:'transfer', s:'next'},
 {f:'Registries & compliance', t:'Licence and permit verification per jurisdiction',
  l:'One query, dozens of authorities, and no API anywhere among them.', p:'transfer', s:'next'},
 {f:'Registries & compliance', t:'Sanctions and watchlist screening across portals',
  l:'A name entered into many portals that never agreed on an interface between them.', p:'transfer', s:'next'},
 {f:'Registries & compliance', t:'Filings on one platform, many companies',
  l:'Identical form, different values — the case the compiler was built for.', p:'transfer', s:'next'},
 {f:'Registries & compliance', t:'Tender and grant submissions across agency portals',
  l:'One procedure, dozens of agencies, each with its own form and its own idea of a deadline.', p:'transfer', s:'next'},

 {f:'Verification & equivalence', t:'Proving two systems agree after a migration',
  l:'Learn "read the value at this place" once and apply it to every page. Nobody automates this, because a script per page is absurd.', p:'verify', s:'next'},
 {f:'Verification & equivalence', t:'One entity checked across ten SaaS tools',
  l:'The same customer in CRM, billing, support and warehouse: search, open a record, read a field, compare.', p:'transfer', s:'next'},
 {f:'Verification & equivalence', t:'Reconciling a ledger against a provider portal',
  l:'The provider will never hand you the file. The portal is the only source of truth there is.', p:'verify', s:'next'},
 {f:'Verification & equivalence', t:'Price and catalogue parity across storefronts',
  l:'Your own prices, in every place they are published, checked rather than sampled.', p:'verify', s:'next'},
 {f:'Verification & equivalence', t:'A regression suite for business processes',
  l:'A set of skills run after every release. A skill fails exactly where a process broke — and says which step.', p:'verify', s:'next'},

 {f:'Sweeps at scale', t:'Repository and project sweeps',
  l:'Commits, issues, pull requests and releases across a hundred projects. Learned once, then zero model calls for each of them.', p:'cost', s:'proven'},
 {f:'Sweeps at scale', t:'One dashboard, many tenants',
  l:'The same report for ten clients: log in, open, read the number. "Different data" means different tenants.', p:'transfer', s:'next'},
 {f:'Sweeps at scale', t:'Merchant onboarding across provider portals',
  l:'The same attached documents and the same fields, into a different portal every time.', p:'transfer', s:'next'},
 {f:'Sweeps at scale', t:'Creator and publisher reporting across a hundred channels',
  l:'A number lives behind a login on each platform, and none of them offers an API for it.', p:'cost', s:'next'},
 {f:'Sweeps at scale', t:'Inventory truth across supplier portals',
  l:'What they say they have, read from their own portal rather than from their feed.', p:'cost', s:'next'},

 {f:'Monitoring & drift', t:'A canary for interface drift',
  l:'A year-old skill run against today\'s site reports where the interface moved in a way that breaks a working process.', p:'shape', s:'next'},
 {f:'Monitoring & drift', t:'Uptime of a process, not of an endpoint',
  l:'An endpoint answering 200 tells you nothing about whether the work still completes.', p:'shape', s:'next'},
 {f:'Monitoring & drift', t:'Silent change behind a supplier\'s quoting page',
  l:'The interface did not change; the answer behind it did. Only a skill that resolves notices the difference.', p:'shape', s:'next'},
 {f:'Monitoring & drift', t:'Watching a regulator\'s form for changes',
  l:'Compliance deadlines move quietly. A skill that fails to resolve its step is the alarm.', p:'shape', s:'next'},

 {f:'Offline & constrained', t:'The air-gapped agent',
  l:'Defence, medicine, a laboratory with no internet at all. The compiled path makes no network call, ever.', p:'offline', s:'next'},
 {f:'Offline & constrained', t:'Factory floor and industrial panels',
  l:'An operator terminal on a plant network, where a cloud round trip per step is not an option.', p:'offline', s:'next'},
 {f:'Offline & constrained', t:'Ship, rig and field equipment',
  l:'Intermittent connectivity is the normal condition there, not an incident to recover from.', p:'offline', s:'next'},
 {f:'Offline & constrained', t:'Working straight through a provider outage',
  l:'A rate limit, a revoked key or a dead provider stops the first run only — every later run is untouched. Also proven by accident.', p:'offline', s:'proven'},

 {f:'Agent engineering', t:'Autopsy of a failing agent',
  l:'Run it, compile the successful prefix, and diff that against what it actually does. The divergence is the specification of what it should have been.', p:'artifact', s:'next'},
 {f:'Agent engineering', t:'A regression suite for someone else\'s agent',
  l:'Compiled skills as the test suite agent vendors never ship with their product.', p:'artifact', s:'next'},
 {f:'Agent engineering', t:'The compiler as a data engine',
  l:'Every run yields state to decision to outcome, with the outcome verified by the runtime rather than asserted by a model — exactly the material for training small fast policies.', p:'traces', s:'next'},
 {f:'Agent engineering', t:'Undocumented internal tools, made executable',
  l:'One expert run produces a living instruction that can also be executed. Documentation stops being prose.', p:'artifact', s:'next'},
 {f:'Agent engineering', t:'Automation approved before it runs',
  l:'In a regulated process you sign the file, not the model. An approval path for agent behaviour that does not otherwise exist.', p:'artifact', s:'next'},

 {f:'Economics & markets', t:'Underwriting task prices in an agent market',
  l:'If the thousandth run is free, the agent that has done the work before can undercut everyone else without giving up margin.', p:'cost', s:'next'},
 {f:'Economics & markets', t:'Skills as a tradeable asset',
  l:'A readable file you can sell, buy, review and diff. The unit of trade becomes the skill, not the run.', p:'artifact', s:'next'},
 {f:'Economics & markets', t:'One expert session turned into a capability',
  l:'Knowledge walks out of the door less often when a single session compiles into a program.', p:'cost', s:'next'},

 {f:'Research & data', t:'Reproducing a procedure described in a paper',
  l:'The described data-collection procedure compiled and re-run, with the provenance of every step kept.', p:'traces', s:'next'},
 {f:'Research & data', t:'Re-running an old data pull to see what moved',
  l:'Same procedure, same shape, later data — and every step reports how it resolved.', p:'shape', s:'next'}
];
const PROPS = {
  transfer:'leans on transfer between instances',
  verify:'leans on the price of checking',
  cost:'leans on cost per shape, not per run',
  offline:'leans on no network in the decision',
  artifact:'leans on a readable, signable artifact',
  traces:'leans on verified traces',
  shape:'leans on the shape being the unit'
};
(function () {
  const appEl = document.getElementById('apps');
  const chipEl = document.getElementById('chips');
  const btn = document.getElementById('expand');
  const hint = document.getElementById('hint');
  if (!appEl) return;
  const fams = [...new Set(APPS.map(a => a.f))];
  let open = false, filter = '*';

  function render() {
    chipEl.innerHTML = '';
    const mk = (label, val) => {
      const b = document.createElement('span');
      b.className = 'pill';
      b.style.cursor = 'pointer';
      if (filter === val) { b.style.borderColor = 'var(--acc)'; b.style.color = 'var(--acc)'; }
      b.textContent = label;
      b.onclick = () => { open = true; filter = val; render(); };
      return b;
    };
    chipEl.appendChild(mk('all families', '*'));
    for (const f of fams) chipEl.appendChild(mk(f, f));

    if (!open) {
      appEl.innerHTML = '';
      btn.textContent = 'Show all ' + APPS.length + ' applications';
      hint.textContent = 'in ' + fams.length + ' families, or pick a family';
      return;
    }
    btn.textContent = 'Hide the list';
    hint.textContent = APPS.length + ' applications across ' + fams.length + ' families';
    const shown = APPS.filter(a => filter === '*' || a.f === filter);
    appEl.innerHTML = '<div class="grid g2">' + shown.map(a => `
      <div class="card">
        <span class="tag">${a.f} · ${a.s === 'proven'
          ? '<span class="ok">proven today</span>' : 'same machinery'}</span>
        <h4>${a.t}</h4>
        <p>${a.l}</p>
        <p style="margin-top:10px;color:var(--acc);font:12px/1.5 var(--mono)">${PROPS[a.p]}</p>
      </div>`).join('') + '</div>';
  }

  btn.onclick = () => { open = !open; if (open) filter = '*'; render(); };
  if (location.hash === '#all') open = true;   // одна ссылка открывает сразу всё
  render();
})();
</script>

</body></html>
